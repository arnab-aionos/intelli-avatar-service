# ====================================
# IntelliAvatar Service Configuration
# ====================================

# --- Self-hosted LLM (AIONOS H200 - Default) ---
# Set USE_SELF_HOSTED_LLM=True to use your H200 cluster
USE_SELF_HOSTED_LLM=True
SELF_HOSTED_LLM_URL=http://154.201.127.0:5000/v1
SELF_HOSTED_LLM_MODEL=self-hosted

# --- Azure OpenAI (Optional - Fallback) ---
# Set USE_SELF_HOSTED_LLM=False to use Azure instead
AZURE_OPENAI_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# --- Server Configuration ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
API_PORT=8001
DEBUG=False

# --- MuseTalk Configuration ---
MUSETALK_MODELS_PATH=./Musetalk/musetalk/models
MUSETALK_DEVICE=cpu
MUSETALK_FPS=25
MUSETALK_BATCH_SIZE=4

# --- Authentication ---
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Logging ---
LOG_LEVEL=INFO

# --- Optional: LiveKit (Not used in WebSocket mode) ---
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your-livekit-api-key
# LIVEKIT_API_SECRET=your-livekit-api-secret
